{
  "rules": {
    "accounts": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('accounts').child($uid).child('users').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid == $uid || root.child('accounts').child($uid).child('users').child(auth.uid).exists())"
      }
    }
  }
}
