rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // 1. CORE FUNCTIONS & AUTHENTICATION HELPERS
    // ---------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isRegistered() {
      return isAuthenticated() && exists(getUserDoc());
    }

    function getUserData() {
      return get(getUserDoc()).data;
    }

    function isActive() {
      return !isRegistered() ||
        (getUserData().get('isActive', true) == true);
    }

    function getRole() {
      return isRegistered() && ('role' in getUserData())
        ? getUserData().role
        : 'Staff';
    }

    function isAdmin() {
      let role = getRole();
      return role == 'Administrator' ||
             role == 'ADMINISTRATOR' ||
             role == 'Admin' ||
             role == 'ADMIN';
    }

    function isManager() {
      let role = getRole();
      return role == 'Manager' ||
             role == 'MANAGER';
    }

    function isAuthorized() {
      return isAuthenticated() && isActive();
    }


    // ---------------------------------------------------------
    // 2. USERS & STAFF
    // ---------------------------------------------------------

    match /users/{userId} {

      // Administrator and Manager can read all users; normal users can only read their own profile.
      allow read: if isAuthorized() && (
        isAdmin() ||
        isManager() ||
        request.auth.uid == userId
      );


      // -------------------------------------------------------
      // CREATE
      //
      // 1. User can create their own initial profile (non-privileged role only).
      // 2. Administrator can create Staff/Manager/Admin profiles.
      // -------------------------------------------------------

      allow create: if isAuthenticated() && (
        (
          request.auth.uid == userId &&
          (
            !('role' in request.resource.data) ||
            !(request.resource.data.role in [
              'Administrator', 'ADMINISTRATOR', 'Admin', 'ADMIN',
              'Manager', 'MANAGER'
            ])
          )
        ) ||
        (
          isAuthorized() &&
          isAdmin()
        )
      );


      // -------------------------------------------------------
      // UPDATE
      //
      // Administrator can manage any user.
      //
      // Normal user can update only their own profile,
      // while role/isActive/firebaseUid cannot be changed.
      // -------------------------------------------------------

      allow update: if isAuthorized() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', 'Staff') == resource.data.get('role', 'Staff') &&
          request.resource.data.get('isActive', true) == resource.data.get('isActive', true) &&
          request.resource.data.get('firebaseUid', userId) == resource.data.get('firebaseUid', userId)
        )
      );


      // -------------------------------------------------------
      // DELETE
      // Only Administrator can delete staff/user profiles.
      // -------------------------------------------------------

      allow delete: if isAuthorized() && isAdmin();
    }


    // ---------------------------------------------------------
    // 3. POS MODULES
    // ---------------------------------------------------------

    // Categories
    match /categories/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // Menu Items / Products
    match /menu_items/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // Offers
    match /offers/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // Tables
    match /tables/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // ---------------------------------------------------------
    // 4. ORDERS
    // ---------------------------------------------------------

    match /orders/{docId} {
      allow read, create, update: if isAuthorized();

      allow delete: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // Order Items
    match /order_items/{docId} {
      allow read, create, update: if isAuthorized();

      allow delete: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // Expenses
    match /expenses/{docId} {
      allow read, create, update: if isAuthorized();

      allow delete: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // ---------------------------------------------------------
    // 5. STOCK & INVENTORY
    // ---------------------------------------------------------

    match /stock_logs/{docId} {

      allow read: if isAuthorized();

      allow create: if isAuthorized();

      allow update, delete: if isAuthorized() &&
        (isAdmin() || isManager());
    }


    // ---------------------------------------------------------
    // 6. SYSTEM SETTINGS
    // ---------------------------------------------------------

    match /printer_settings/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isAdmin();
    }


    match /receipt_settings/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isAdmin();
    }


    // ---------------------------------------------------------
    // 7. NOTIFICATIONS
    // ---------------------------------------------------------

    match /notifications/{docId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized();
    }


    // ---------------------------------------------------------
    // 8. GLOBAL FALLBACK
    // ---------------------------------------------------------

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

